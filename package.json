{
    "name": "wbk--frontend-playground",
    "version": "2.0.0",
    "type": "module",
    "description": "Ultimate Frontend Playground: Multi-SSG Framework Showcase - The most comprehensive Static Site Generator comparison platform ever built",
    "author": "Paul Serban <paul.alex.serban@gmail.com>",
    "license": "MIT",
    "private": true,
    "keywords": [
        "ssg",
        "static-site-generator",
        "frontend",
        "multi-framework",
        "comparison",
        "nextjs",
        "nuxtjs",
        "sveltekit",
        "astro",
        "hugo",
        "jekyll",
        "pelican"
    ],
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.9.0",
        "yarn": ">=1.22.0"
    },
    "scripts": {
        "start:package": "npx serve package",
        "///// INSTALLATION SCRIPTS /////": "",
        "install:all": "yarn && yarn install:libraries && yarn install:dashboard",
        "install:dashboard": "cd dashboard && yarn || echo '⚠️  Dashboard not initialized'",
        "install:libraries": "yarn install:lib:dev-days-matrix && yarn install:lib:frontend-mentor",
        "install:lib:dev-days-matrix": "cd libraries/dev-days-matrix-library && pwd && yarn",
        "install:lib:frontend-mentor": "cd libraries/frontend-mentor-library && pwd && yarn || echo '⚠️  Frontend Mentor Library not initialized'",
        "///// UNIVERSAL BUILD SCRIPTS /////": "",
        "build:all": "yarn build:libraries && yarn package:libraries && yarn build:dashboard",
        "build:dashboard": "node dashboard",
        "build:libraries": "yarn build:lib:dev-days-matrix && yarn build:lib:frontend-mentor",
        "build:lib:dev-days-matrix": "cd libraries/dev-days-matrix-library && pwd && yarn build || echo '⚠️  Dev Days Matrix Library not built'",
        "build:lib:frontend-mentor": "cd libraries/frontend-mentor-library && pwd && yarn build || echo '⚠️  Frontend Mentor Library not built'",
        "///// PACKAGE SCRIPTS /////": "",
        "package:libraries":"bash scripts/package-libraries.bash",
        "///// CODE QUALITY SCRIPTS /////": "",
        "test:dashboard:catalog": "node --test dashboard/core/catalog/*.test.js",
        "test:dashboard:rendering": "node --test dashboard/core/rendering/*.test.js",
        "test:dashboard:templates": "node --test dashboard/core/templates/*.test.js",
        "test:dashboard:core": "node --test dashboard/core/*.test.js",
        "test:dashboard:quality": "node --test dashboard/quality/*.test.js",
        "test:dashboard": "yarn test:dashboard:catalog && yarn test:dashboard:rendering && yarn test:dashboard:templates && yarn test:dashboard:core && yarn test:dashboard:quality",
        "lint:dashboard": "node dashboard/quality/lintDashboard.js",
        "verify:dashboard": "node dashboard/quality/runIntegrityChecks.js",
        "check:dashboard": "yarn test:dashboard && yarn lint:dashboard && yarn build:dashboard",
        "formats:write": "prettier --write '**/*.{js,ts,vue,svelte,md,json,yaml,yml}'",
        "formats:check": "prettier --check '**/*.{js,ts,vue,svelte,md,json,yaml,yml}'",
        "///// GIT HOOKS & COMMIT SCRIPTS /////": "",
        "commit": "git-cz",
        "precommit": "lint-staged"
    },
    "dependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@types/node": "^24.6.2",
        "chalk": "^4.1.2",
        "commander": "^11.0.0",
        "cross-spawn": "^7.0.3",
        "cz-conventional-changelog": "^3.3.0",
        "dotenv": "^17.3.1",
        "fs-extra": "^11.0.0",
        "glob": "^10.0.0",
        "husky": "^9.1.7",
        "inquirer": "^8.2.0",
        "lint-staged": "^16.2.3",
        "ora": "^5.4.1",
        "prettier": "^3.6.2",
        "semver": "^7.5.0",
        "typescript": "^5.9.3"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "lint-staged": {
        "*.{js,ts,vue,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{md,json,yaml,yml}": [
            "prettier --write"
        ]
    },
    "repository": "https://github.com/paulAlexSerban/wbk--frontend-playground.git",
    "bugs": {
        "url": "https://github.com/paulAlexSerban/wbk--frontend-playground/issues"
    },
    "homepage": "https://paulalexserban.github.io/wbk--frontend-playground/",
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ],
    "main": "index.js"
}
