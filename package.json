{
    "name": "@wbk-frontend-forge/core",
    "version": "2.0.0",
    "type": "module",
    "author": "Paul Serban <paul.alex.serban@gmail.com>",
    "license": "MIT",
    "private": true,
    "engines": {
        "node": ">=24.14.0",
        "npm": ">=11.9.0",
        "yarn": ">=1.22.22"
    },
    "scripts": {
        "start:package": "npx serve package",
        "test:dashboard": "node --test dashboard/**/*.test.js",
        "lint:dashboard": "node dashboard/quality/lintDashboard.js",
        "check:dashboard": "yarn test:dashboard && yarn lint:dashboard && yarn build:dashboard",
        "build": "lerna run build",
        "build:prod": "NODE_ENV=production lerna run build:prod",
        "/// CODE QUALITY SCRIPTS ///": "",
        "formats:write": "prettier --write '**/*.{js,ts,vue,svelte,md,json,yaml,yml}'",
        "formats:check": "prettier --check '**/*.{js,ts,vue,svelte,md,json,yaml,yml}'",
        "/// PACKAGE SCRIPTS ///": "",
        "new:project": "node scripts/new-project.js",
        "package:projects": "bash scripts/package-projects.bash",
        "build:dashboard": "bash scripts/package-projects.bash && node dashboard",
        "/// GIT HOOKS & COMMIT SCRIPTS ///": "",
        "precommit": "lint-staged"
    },
    "dependencies": {
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.2",
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@types/node": "^24.6.2",
        "babel-loader": "^10.1.1",
        "chalk": "^4.1.2",
        "commander": "^11.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "cross-spawn": "^7.0.3",
        "css-loader": "^7.1.4",
        "cz-conventional-changelog": "^3.3.0",
        "dotenv": "^17.3.1",
        "fs-extra": "^11.0.0",
        "glob": "^10.0.0",
        "handlebars-loader": "^1.7.3",
        "html-webpack-plugin": "^5.6.6",
        "husky": "^9.1.7",
        "inquirer": "^8.2.0",
        "lerna": "^9.0.7",
        "lint-staged": "^16.2.3",
        "mini-css-extract-plugin": "^2.10.2",
        "ora": "^5.4.1",
        "prettier": "^3.6.2",
        "sass": "^1.98.0",
        "sass-loader": "^16.0.7",
        "semver": "^7.5.0",
        "terser-webpack-plugin": "^5.4.0",
        "typescript": "^5.9.3",
        "webpack": "^5.105.4",
        "webpack-cli": "^7.0.2",
        "webpack-merge": "^6.0.1"
    },
    "workspaces": {
        "packages": [
            "projects/*/*",
            "projects/*/*/*"
        ],
        "nohoist": [
            "**/normalize-scss"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "lint-staged": {
        "*.{js,ts,vue,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{md,json,yaml,yml}": [
            "prettier --write"
        ]
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ]
}
