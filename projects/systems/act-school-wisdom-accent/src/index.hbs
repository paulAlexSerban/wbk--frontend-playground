<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Art School - Design System</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{{feLibs 'all'}}}

  <link href="https://fonts.googleapis.com/css?family=Playfair+Display:700,900|Open+Sans:400,600&display=swap"
    rel="stylesheet">
</head>
<script>

</script>

<body>
  <select onchange="setTheme(this.value)" style="position: fixed; top: 1rem; right: 1rem; z-index: 1000;">
    <option value="wisdom-accent">Wisdom Accent</option>
    <option value="vivid-theatre">Vivid Theatre</option>
    <option value="elegant-warm">Elegant & Warm</option>
    <option value="fresh-energetic">Fresh & Energetic</option>
  </select>
  <select onchange="setDarkLightTheme(this.value)" style="position: fixed; top: 3rem; right: 1rem; z-index: 1000;">
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>


  <div class="container">
    <h1>Art School - Design System</h1>
    <p>This page visualizes the core color palette, typography, and primary UI components for the Art School brand.</p>

    <h2>Color Palette</h2>
    <div class="swatch-row">
      <div class="swatch">
        <div class="swatch-color" style="background: var(--primary);"></div>
        <div class="swatch-label">Primary</div>
        <div class="swatch-value">#302e5a</div>
      </div>
      <div class="swatch">
        <div class="swatch-color" style="background: var(--accent);"></div>
        <div class="swatch-label">Accent</div>
        <div class="swatch-value">#ff8800</div>
      </div>
      <div class="swatch">
        <div class="swatch-color" style="background: var(--highlight);"></div>
        <div class="swatch-label">Highlight</div>
        <div class="swatch-value">#e94e77</div>
      </div>
      <div class="swatch">
        <div class="swatch-color" style="background: var(--neutral); border: 1.5px solid #bbb;"></div>
        <div class="swatch-label">Neutral</div>
        <div class="swatch-value">#f7f7f9</div>
      </div>
      <div class="swatch">
        <div class="swatch-color" style="background: var(--text);"></div>
        <div class="swatch-label">Text</div>
        <div class="swatch-value">#222</div>
      </div>
      <div class="swatch">
        <div class="swatch-color" style="background: var(--success);"></div>
        <div class="swatch-label">Success</div>
        <div class="swatch-value">#19b37a</div>
      </div>
      <div class="swatch">
        <div class="swatch-color" style="background: var(--danger);"></div>
        <div class="swatch-label">Danger</div>
        <div class="swatch-value">#e74c3c</div>
      </div>
    </div>

    <h2>Typography</h2>
    <div class="type-sample">
      <div class="type-label">Heading 1 (Playfair Display, 2.7rem)</div>
      <div class="type-heading" style="font-size:2.7rem;">Unleash Your Talent</div>
    </div>
    <div class="type-sample">
      <div class="type-label">Heading 2 (Playfair Display, 2rem)</div>
      <div class="type-heading" style="font-size:2rem;">Explore Our Courses</div>
    </div>
    <div class="type-sample">
      <div class="type-label">Body Text (Open Sans, 1rem)</div>
      <div class="type-body" style="font-size:1rem;">
        Amateur acting, masterclasses, and soft skill training for every creative soul.
      </div>
    </div>
    <div class="type-sample">
      <div class="type-label">Monospace (Fira Mono, 1rem)</div>
      <div class="type-mono">let yourCreativity = 'shine';</div>
    </div>

    <h2>Primary UI Components</h2>
    <div class="ui-section">
      <h3>Buttons</h3>
      <div class="ui-row">
        <button class="btn btn-primary">Primary Button</button>
        <button class="btn btn-accent">Accent Button</button>
        <button class="btn btn-outline">Outline Button</button>
        <button class="btn btn-success">Success</button>
        <button class="btn btn-danger">Danger</button>
      </div>
    </div>

    <div class="ui-section">
      <h3>Card</h3>
      <div class="ui-row">
        <div class="card">
          <div class="card-title">Acting for Beginners</div>
          <div class="card-meta">Course · Level: Intro</div>
          <div class="card-body">
            Discover the basics of stage presence and confidence with our hands-on introductory course.
          </div>
          <button class="btn btn-accent">Learn More</button>
        </div>
        <div class="card">
          <div class="card-title">Masterclass: Improv</div>
          <div class="card-meta">Masterclass · Sept 30</div>
          <div class="card-body">
            Join our expert for a one-day improvisation workshop. Fun, fast-paced, and unforgettable!
          </div>
          <button class="btn btn-primary">Register</button>
        </div>
      </div>
    </div>

    <div class="ui-section">
      <h3>Inputs</h3>
      <div class="ui-row">
        <div class="input-group">
          <label class="input-label" for="name">Name</label>
          <input class="input-field" id="name" type="text" placeholder="Your name">
        </div>
        <div class="input-group">
          <label class="input-label" for="email">Email</label>
          <input class="input-field" id="email" type="email" placeholder="you@email.com">
        </div>
      </div>
    </div>

    <div class="ui-section">
      <h3>Testimonial</h3>
      <div class="testimonial">
        The courses completely unlocked my self-confidence on stage!
        <div class="testimonial-author">— Alex, Student</div>
      </div>
    </div>
  </div>
</body>

</html>