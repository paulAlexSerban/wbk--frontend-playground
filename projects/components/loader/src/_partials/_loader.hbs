{{> _auto-text}}

{{> _kinetic-loader}}

<article class="demo-card blurry-loader" data-js-cmp="BlurryLoader">
    <div>
        <p class="demo-label">Variation</p>
        <h2>Blurry Loader</h2>
        <p class="demo-copy">Loading text fades as the background image sharpens, preserving the legacy timing and blur progression.</p>
    </div>

    <div class="blurry-loader__base">
        <img
            class="blurry-loader__background-image js-blurry-loader-background"
            src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=80"
            alt="Worker background"
        />
        <p class="blurry-loader__loading-text js-blurry-loader-loading-text">0%</p>
    </div>
</article>
