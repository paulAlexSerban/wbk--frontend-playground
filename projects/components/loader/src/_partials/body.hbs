<body class="loader-page">
    <main class="page-shell">
        <header class="page-header">
            <p class="eyebrow">Component</p>
            <h1>Loader</h1>
            <p class="page-copy">Two loader experiments migrated into a single component playground: a kinetic triangle animation and a configurable auto-text loop.</p>
        </header>

        <section class="demo-grid">
            <article class="demo-card demo-card--dark">
                <div>
                    <p class="demo-label">Variation</p>
                    <h2>Kinetic Loader</h2>
                    <p class="demo-copy">Pure CSS rotation built from two overlapping triangle borders.</p>
                </div>
                <div class="kinetic-stage">
                    <div class="kinetic-loader"></div>
                </div>
            </article>

            <article class="demo-card demo-card--warm" data-auto-text data-text="Lorem ipsum dolor sit amet, consectetur adipisicing elit.">
                <div>
                    <p class="demo-label">Variation</p>
                    <h2>Auto Text</h2>
                    <p class="demo-copy">Typewriter loop with adjustable playback speed.</p>
                </div>
                <div class="auto-text-stage">
                    <p class="auto-text-output" data-auto-text-output>Starting...</p>
                    <label class="speed-control" for="loader-speed">
                        <span>Speed</span>
                        <input id="loader-speed" data-auto-text-speed type="range" min="1" max="10" step="1" value="4">
                    </label>
                </div>
            </article>
        </section>
    </main>
</body>