<article class="demo-card demo-card--js-tabs" data-navigation-tabs-js>
    <div>
        <p class="demo-label">Variation</p>
        <h2>Navigation Tabs (JavaScript)</h2>
        <p class="demo-copy">Click buttons to switch active tab and matching content panel.</p>
    </div>

    <div class="navigation-tabs-js__base">
        <ul class="navigation-tabs-js__tab-list">
            <li><button class="navigation-tabs-js__tab-button is-active" type="button" data-tab-button data-id="tab1">TAB-1</button></li>
            <li><button class="navigation-tabs-js__tab-button" type="button" data-tab-button data-id="tab2">TAB-2</button></li>
            <li><button class="navigation-tabs-js__tab-button" type="button" data-tab-button data-id="tab3">TAB-3</button></li>
        </ul>

        <ul class="navigation-tabs-js__panels">
            <li class="navigation-tabs-js__panel is-active" data-tab-panel data-id="tab1">
                <h3>Heading Tab One</h3>
                <p>Content of tab one.</p>
            </li>
            <li class="navigation-tabs-js__panel" data-tab-panel data-id="tab2">
                <h3>Heading Tab Two</h3>
                <p>Content of tab two.</p>
            </li>
            <li class="navigation-tabs-js__panel" data-tab-panel data-id="tab3">
                <h3>Heading Tab Three</h3>
                <p>Content of tab three.</p>
            </li>
        </ul>
    </div>
</article>
