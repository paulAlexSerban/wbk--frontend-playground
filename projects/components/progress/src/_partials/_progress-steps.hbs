<article class="demo-card" data-progress-steps>
    <div>
        <p class="demo-label">Variation</p>
        <h2>Progress Steps</h2>
        <p class="demo-copy">Use next and previous actions to advance or rewind the active progress state.</p>
    </div>

    <div class="progress-steps__container">
        <div class="progress-steps__track">
            <div class="progress-steps__bar" data-progress-bar></div>
            <span class="progress-steps__pill is-active" data-progress-pill>1</span>
            <span class="progress-steps__pill" data-progress-pill>2</span>
            <span class="progress-steps__pill" data-progress-pill>3</span>
            <span class="progress-steps__pill" data-progress-pill>4</span>
        </div>
        <div class="progress-steps__buttons">
            <button class="progress-steps__button" type="button" data-progress-prev disabled>Prev</button>
            <button class="progress-steps__button" type="button" data-progress-next>Next</button>
        </div>
    </div>
</article>
