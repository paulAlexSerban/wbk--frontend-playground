<article class="demo-card timer-demo" data-js-timer>
    <div>
        <p class="demo-label">Variation 1</p>
        <h2>Animated Countdown</h2>
        <p class="demo-copy">The countdown still sequences with `animationend` transitions exactly like the legacy demo.</p>
    </div>

    <div class="timer-demo__stage">
        <div class="counter js-counter">
            <div class="nums js-nums">
                <span class="in">3</span>
                <span>2</span>
                <span>1</span>
                <span>0</span>
            </div>
            <h4>Get Ready</h4>
        </div>

        <div class="final js-final">
            <h3>GO</h3>
            <button class="timer-demo__replay js-replay" type="button">
                <span>Replay</span>
            </button>
        </div>
    </div>
</article>
