<article class="demo-card">
    <div>
        <p class="demo-label">Variation 1</p>
        <h2>Custom Range Slider</h2>
    </div>
    <div class="range-container js-range-container">
        <input type="range" class="js-range-input" min="0" max="100" value="50">
        <label class="js-range-label">50</label>
    </div>
</article>

<article class="demo-card">
    <div>
        <p class="demo-label">Variation 2</p>
        <h2>Search Hidden</h2>
    </div>
    <div class="search-hidden__base" data-js-pat="SearchHidden">
        <div class="search-hidden__container js-search">
            <label class="search-hidden__label" for="fc-search"></label>
            <input type="text" class="search-hidden__input js-search-input" placeholder="Search..." id="fc-search" />
            <button class="search-hidden__btn js-search-btn">
                <svg class="search-hidden__magnifying-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
            </button>
        </div>
    </div>
</article>

<article class="demo-card">
    <div>
        <p class="demo-label">Variation 3</p>
        <h2>Text Input</h2>
    </div>
    <div>
        <label class="input__label" for="fc-username">Username</label>
        <input class="input__input" type="text" id="fc-username" placeholder="Enter username" />
    </div>
</article>
