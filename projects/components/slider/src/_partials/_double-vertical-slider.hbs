<article class="demo-card demo-card--vertical" data-vertical-slider>
    <div>
        <p class="demo-label">Variation</p>
        <h2>Double Vertical Slider</h2>
        <p class="demo-copy">Two stacked columns that move in opposite directions.</p>
    </div>
    <div class="vertical-slider">
        <div class="vertical-slider__left" data-vertical-left>
            <section class="vertical-panel" style="--panel-background: #fd3555;">
                <h3>Nature flower</h3>
                <p>All in pink</p>
            </section>
            <section class="vertical-panel" style="--panel-background: #2a86ba;">
                <h3>Bluuue sky</h3>
                <p>With its mountains</p>
            </section>
            <section class="vertical-panel" style="--panel-background: #252e33;">
                <h3>Lonely castle</h3>
                <p>In the wilderness</p>
            </section>
            <section class="vertical-panel" style="--panel-background: #ffb866;">
                <h3>Flying eagle</h3>
                <p>In the sunset</p>
            </section>
        </div>
        <div class="vertical-slider__right" data-vertical-right>
            <section class="vertical-photo" style="--panel-background: linear-gradient(135deg, #fecdd3, #fb7185);"></section>
            <section class="vertical-photo" style="--panel-background: linear-gradient(135deg, #d9f99d, #4d7c0f);"></section>
            <section class="vertical-photo" style="--panel-background: linear-gradient(135deg, #c7d2fe, #4338ca);"></section>
            <section class="vertical-photo" style="--panel-background: linear-gradient(135deg, #bae6fd, #0f766e);"></section>
        </div>
        <div class="vertical-slider__actions">
            <button type="button" data-vertical-down aria-label="Previous vertical slide">↓</button>
            <button type="button" data-vertical-up aria-label="Next vertical slide">↑</button>
        </div>
    </div>
</article>
