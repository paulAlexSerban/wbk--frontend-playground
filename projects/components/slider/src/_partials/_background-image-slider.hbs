<article class="demo-card demo-card--hero" data-background-slider>
    <div>
        <p class="demo-label">Variation</p>
        <h2>Background Image Slider</h2>
        <p class="demo-copy">A cinematic slider with a synced page backdrop.</p>
    </div>
    <div class="hero-slider" data-background-stage>
        <div class="hero-slider__backdrop"></div>
        <div class="hero-slider__viewport">
            <article class="hero-slide is-active" data-hero-slide style="--slide-background: linear-gradient(135deg, #0f172a, #2563eb);">
                <span>01</span>
                <h3>Coastal night drive</h3>
            </article>
            <article class="hero-slide" data-hero-slide style="--slide-background: linear-gradient(135deg, #14532d, #4ade80);">
                <span>02</span>
                <h3>Forest observations</h3>
            </article>
            <article class="hero-slide" data-hero-slide style="--slide-background: linear-gradient(135deg, #7c2d12, #fb7185);">
                <span>03</span>
                <h3>Desert sunrise</h3>
            </article>
            <article class="hero-slide" data-hero-slide style="--slide-background: linear-gradient(135deg, #312e81, #a78bfa);">
                <span>04</span>
                <h3>Mountain afterglow</h3>
            </article>
        </div>
        <div class="hero-slider__actions">
            <button type="button" data-hero-prev aria-label="Previous hero slide">←</button>
            <button type="button" data-hero-next aria-label="Next hero slide">→</button>
        </div>
    </div>
</article>
