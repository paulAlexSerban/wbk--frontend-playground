<article class="demo-card paint-demo" data-js-paint>
    <div>
        <p class="demo-label">Variation 1</p>
        <h2>Drawing App</h2>
        <p class="demo-copy">Canvas drawing with brush size, color controls, and clear action, ported from the legacy paint component.</p>
    </div>

    <canvas class="paint-demo__canvas js-paint-canvas" width="800" height="700"></canvas>
    <div class="toolbox">
        <button class="js-decrease" type="button">-</button>
        <span class="js-size">10</span>
        <button class="js-increase" type="button">+</button>
        <input class="js-color" type="color" />
        <button class="js-clear" type="button">X</button>
    </div>
</article>
