<article class="demo-card theme-clock" data-js-theme-switch>
    <div>
        <p class="demo-label">Variation 1</p>
        <h2>Theme Clock</h2>
        <p class="demo-copy">Analog clock with real-time updates and theme toggling, adapted from the legacy theme-switch pattern.</p>
    </div>

    <button class="toggle js-theme-toggle" type="button">Dark mode</button>

    <div class="clock-container">
        <div class="clock">
            <div class="needle hour js-hour"></div>
            <div class="needle minute js-minute"></div>
            <div class="needle second js-second"></div>
            <div class="center-point"></div>
        </div>

        <div class="time js-time"></div>
        <div class="date js-date"></div>
    </div>
</article>
