<article class="demo-card demo-card--faq" data-faq-collapse>
    <div>
        <p class="demo-label">Variation</p>
        <h2>FAQ Collapse</h2>
        <p class="demo-copy">Click each question to toggle expanded answer state.</p>
    </div>

    <div class="faq-container">
        <div class="faq active">
            <h3 class="faq-title">Why shouldn't we trust atoms?</h3>
            <p class="faq-text">They make up everything.</p>
            <button class="faq-toggle" type="button" aria-label="Toggle faq item"><span>+</span><span>×</span></button>
        </div>

        <div class="faq">
            <h3 class="faq-title">What do you call someone with no body and no nose?</h3>
            <p class="faq-text">Nobody knows.</p>
            <button class="faq-toggle" type="button" aria-label="Toggle faq item"><span>+</span><span>×</span></button>
        </div>

        <div class="faq">
            <h3 class="faq-title">How many tickles does it take to tickle an octopus?</h3>
            <p class="faq-text">Ten-tickles!</p>
            <button class="faq-toggle" type="button" aria-label="Toggle faq item"><span>+</span><span>×</span></button>
        </div>
    </div>
</article>
