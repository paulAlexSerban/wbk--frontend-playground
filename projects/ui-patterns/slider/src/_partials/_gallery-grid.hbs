<article class="demo-card demo-card--gallery" data-gallery-grid>
    <div>
        <p class="demo-label">Variation</p>
        <h2>Gallery Grid Pagination</h2>
        <p class="demo-copy">Grid layout with pagination dots to navigate through image groups.</p>
    </div>
    <div class="gallery-grid">
        <div class="gallery-grid__viewport" data-gallery-viewport>
            <article class="gallery-grid__item is-active" data-gallery-page="0" style="--panel-background: linear-gradient(135deg, #3b82f6, #111827);">01</article>
            <article class="gallery-grid__item is-active" data-gallery-page="0" style="--panel-background: linear-gradient(135deg, #22c55e, #14532d);">02</article>
            <article class="gallery-grid__item is-active" data-gallery-page="0" style="--panel-background: linear-gradient(135deg, #f97316, #7c2d12);">03</article>
            <article class="gallery-grid__item is-active" data-gallery-page="0" style="--panel-background: linear-gradient(135deg, #a855f7, #312e81);">04</article>
            <article class="gallery-grid__item" data-gallery-page="1" style="--panel-background: linear-gradient(135deg, #ec4899, #831843);">05</article>
            <article class="gallery-grid__item" data-gallery-page="1" style="--panel-background: linear-gradient(135deg, #06b6d4, #164e63);">06</article>
            <article class="gallery-grid__item" data-gallery-page="1" style="--panel-background: linear-gradient(135deg, #f59e0b, #78350f);">07</article>
            <article class="gallery-grid__item" data-gallery-page="1" style="--panel-background: linear-gradient(135deg, #6366f1, #1e1b4b);">08</article>
            <article class="gallery-grid__item" data-gallery-page="2" style="--panel-background: linear-gradient(135deg, #ef4444, #4c0519);">09</article>
            <article class="gallery-grid__item" data-gallery-page="2" style="--panel-background: linear-gradient(135deg, #14b8a6, #134e4a);">10</article>
            <article class="gallery-grid__item" data-gallery-page="2" style="--panel-background: linear-gradient(135deg, #84cc16, #3f3f00);">11</article>
            <article class="gallery-grid__item" data-gallery-page="2" style="--panel-background: linear-gradient(135deg, #8b5cf6, #4c1d95);">12</article>
        </div>
        <div class="gallery-grid__pagination" data-gallery-pagination>
            <button class="gallery-grid__dot is-active" type="button" data-gallery-dot="0"></button>
            <button class="gallery-grid__dot" type="button" data-gallery-dot="1"></button>
            <button class="gallery-grid__dot" type="button" data-gallery-dot="2"></button>
        </div>
    </div>
</article>
