<article class="demo-card demo-card--carousel" data-image-carousel>
    <div>
        <p class="demo-label">Variation</p>
        <h2>Image Carousel</h2>
        <p class="demo-copy">Auto-advancing carousel with manual previous and next controls.</p>
    </div>
    <div class="image-carousel">
        <div class="image-carousel__viewport">
            <div class="image-carousel__track" data-carousel-track>
                <article class="image-carousel__item" style="--panel-background: linear-gradient(135deg, #38bdf8, #1e3a8a);">
                    <span>Research</span>
                </article>
                <article class="image-carousel__item" style="--panel-background: linear-gradient(135deg, #f9a8d4, #9d174d);">
                    <span>Design</span>
                </article>
                <article class="image-carousel__item" style="--panel-background: linear-gradient(135deg, #86efac, #166534);">
                    <span>Build</span>
                </article>
                <article class="image-carousel__item" style="--panel-background: linear-gradient(135deg, #fdba74, #c2410c);">
                    <span>Launch</span>
                </article>
            </div>
        </div>
        <div class="image-carousel__actions">
            <button type="button" data-carousel-prev>Prev</button>
            <button type="button" data-carousel-next>Next</button>
        </div>
    </div>
</article>
