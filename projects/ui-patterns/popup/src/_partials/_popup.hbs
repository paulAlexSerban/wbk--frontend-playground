<article class="demo-card" data-popup>
    <div>
        <p class="demo-label">Variation</p>
        <h2>Popup</h2>
        <p class="demo-copy">Open the popup and close by icon, action button, or clicking backdrop.</p>
    </div>

    <div class="popup__base">
        <button class="popup__open" type="button" data-popup-open>Open Popup</button>

        <div class="popup__wrapper" data-popup-wrapper>
            <div class="popup__modal" role="dialog" aria-modal="true" aria-label="Ninja sale popup">
                <button class="popup__close" type="button" data-popup-close aria-label="Close popup">x</button>
                <div class="popup__content">
                    <h3>NINJA SALE!!</h3>
                    <p>50% off all ninja clothing. Don't miss out!</p>
                    <button class="popup__action" type="button" data-popup-action>View Clothing</button>
                </div>
            </div>
        </div>
    </div>
</article>
