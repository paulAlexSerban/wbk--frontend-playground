<article class="demo-card" data-alert>
    <div>
        <p class="demo-label">Variation</p>
        <h2>Alert</h2>
        <p class="demo-copy">A dismissible notice with title, body copy, link and action button.</p>
    </div>

    <section class="alert-box alert-box--blue" data-alert-item>
        <h3 class="alert-box__title">Alert Title</h3>
        <p class="alert-box__text">Alert text: lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <button class="alert-box__close" type="button" aria-label="Close alert" data-alert-close>&times;</button>
        <div class="alert-box__actions">
            <a class="alert-box__link" href="#" data-alert-close>Link text</a>
            <button class="alert-box__button" type="button" data-alert-close>Alert Action</button>
        </div>
    </section>
</article>
