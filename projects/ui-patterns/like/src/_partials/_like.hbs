<article class="demo-card">
    <div>
        <p class="demo-label">Variation 1</p>
        <h2>Like Image</h2>
        <p class="demo-copy">Double click on the image to like it and spawn animated hearts, matching the legacy interaction.</p>
    </div>

    <div class="like__base" data-js-like>
        <h3 class="like__heading">Double click on the image to <span class="like__heart-icon">♥</span> it</h3>
        <small class="like__counter-copy">You liked it <span class="js-like-count">0</span> times</small>
        <div class="loveMe js-love-me" aria-label="Double click to like the image"></div>
    </div>
</article>
